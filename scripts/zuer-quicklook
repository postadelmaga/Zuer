#!/usr/bin/env bash
# Quick Look alla macOS: una scorciatoia globale (Meta+Space) apre Zuer sul
# file selezionato in Dolphin.
#
# Dolphin non espone la selezione corrente su D-Bus, e le voci dei service menu
# non sono azioni registrate (non compaiono nel suo editor di scorciatoie):
# l'unica via è far scattare l'azione "Copia" della finestra attiva e leggere
# la uri-list dagli appunti, ripristinando poi il contenuto precedente.
#
# Su Wayland un client può scrivere negli appunti solo se ha il focus: funziona
# proprio perché una scorciatoia globale non toglie il focus a Dolphin.
# Il log e il dirottamento di stderr vengono PRIMA di tutto il resto, `set -u`
# compreso: lanciato da KDE questo script non ha un terminale, quindi un errore
# di bash (una variabile non impostata, un binario assente) sparirebbe senza
# lasciare traccia — ed è esattamente il modo in cui ha fallito in silenzio.
LOG="${XDG_RUNTIME_DIR:-/tmp}/zuer-quicklook.log"
exec 2>>"$LOG"
printf '%s  --- avvio pid=%s home=%s xdg=%s shell=%s\n' \
  "$(date '+%H:%M:%S')" "$$" "${HOME:-NON-IMPOSTATA}" "${XDG_RUNTIME_DIR:-NON-IMPOSTATA}" "${BASH_VERSION:-non-bash}" >> "$LOG"

set -u

ZUER="${ZUER_GUI:-$HOME/.local/bin/zuer-gui}"
QDBUS=$(command -v qdbus6 || command -v qdbus) || exit 1
command -v wl-paste >/dev/null || exit 1
dbg() {
  printf '%s  %s\n' "$(date '+%H:%M:%S')" "$*" >> "$LOG"
  [ -n "${ZUER_QL_DEBUG:-}" ] && printf 'zuer-quicklook: %s\n' "$*" >&2
  return 0
}
notify() {
  dbg "$1"
  command -v notify-send >/dev/null && notify-send -a Zuer -i quickview -t 2500 "Zuer" "$1"
}

# La finestra Dolphin attiva: possono esserci più istanze, e più finestre per istanza.
find_window() {
  local svc win
  for svc in $("$QDBUS" 2>/dev/null | tr -d ' ' | grep '^org\.kde\.dolphin'); do
    for win in $("$QDBUS" "$svc" 2>/dev/null | grep -E '^/dolphin/Dolphin_[0-9]+$'); do
      if [ "$("$QDBUS" "$svc" "$win" org.kde.dolphin.MainWindow.isActiveWindow 2>/dev/null)" = true ]; then
        printf '%s %s\n' "$svc" "$win"; return 0
      fi
    done
  done
  return 1
}

if ! read -r svc win < <(find_window); then
  notify "Nessuna finestra di Dolphin attiva."
  exit 0
fi
dbg "finestra: $svc $win"

# "Copia" disabilitata = niente di selezionato: esci senza toccare gli appunti.
copy="$win/actions/edit_copy"
if [ "$("$QDBUS" "$svc" "$copy" org.qtproject.Qt.QAction.enabled 2>/dev/null)" != true ]; then
  notify "Nessun file selezionato."
  exit 0
fi

# Salva il tipo preferito degli appunti, saltando i marcatori interni di KDE.
tmp=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/zuer-ql.XXXXXX")
saved_type=$(wl-paste --list-types 2>/dev/null | grep -v '^application/x-kde-' | head -1)
[ -n "$saved_type" ] && wl-paste --type "$saved_type" --no-newline > "$tmp/clip" 2>/dev/null
dbg "appunti salvati: ${saved_type:-nessuno} ($( [ -f "$tmp/clip" ] && wc -c < "$tmp/clip" || echo 0) byte)"
restore() {
  [ -n "$saved_type" ] && [ -s "$tmp/clip" ] && wl-copy --type "$saved_type" < "$tmp/clip" 2>/dev/null
  rm -rf "$tmp"
}
trap restore EXIT

# Svuotare prima rende l'attesa deterministica: senza questo si rischierebbe di
# leggere la uri-list di una copia precedente.
wl-copy --clear 2>/dev/null
"$QDBUS" "$svc" "$copy" org.qtproject.Qt.QAction.trigger 2>/dev/null

uris=""
for _ in $(seq 24); do
  uris=$(wl-paste --type text/uri-list --no-newline 2>/dev/null) && [ -n "$uris" ] && break
  sleep 0.025
done

if [ -z "$uris" ]; then
  notify "Dolphin non ha copiato la selezione negli appunti."
  exit 0
fi

# Prima riga utile della uri-list → percorso locale (con percent-decoding).
uri=$(printf '%s\n' "$uris" | tr -d '\r' | grep -v '^#' | grep . | head -1)
case "$uri" in
  file://*) ;;
  *) notify "Quick Look supporta solo i file locali."; exit 0 ;;
esac
path=${uri#file://}
path=$(printf '%b' "${path//%/\\x}")
dbg "apro: $path"

# KDE lancia le scorciatoie globali come unità systemd transitorie: all'uscita
# dello script systemd azzera l'intero cgroup, quindi un semplice setsid non
# basta (Zuer si apriva e moriva dopo ~1s). Serve uno scope separato.
if command -v systemd-run >/dev/null; then
  systemd-run --user --quiet --collect --scope -- "$ZUER" "$path" >/dev/null 2>&1 &
else
  setsid "$ZUER" "$path" >/dev/null 2>&1 </dev/null &
fi
# Gli appunti si ripristinano solo dopo che Zuer è partito davvero: il trap
# scatterebbe subito, mentre lo scope sta ancora nascendo.
sleep 0.4
